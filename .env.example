# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不要提交）
# 硅基流动：https://cloud.siliconflow.cn/me/account/ak

RAG_EMBED_PROVIDER=api
RAG_EMBED_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBED_API_KEY=sk-在这里填你的密钥
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_EMBED_DIM=1024
RAG_EMBED_BATCH=32

# 本地兜底（可选）
# RAG_EMBED_FALLBACK=BAAI/bge-small-zh-v1.5

# 向量库：local=本地持久化；http=独立 Chroma 容器
RAG_CHROMA_MODE=local
# RAG_CHROMA_HOST=localhost
# RAG_CHROMA_PORT=8002
RAG_COLLECTION=travel_kb_v1
# 对话模型（DeepSeek）
DEEPSEEK_API_KEY=sk-在这里填你的 DeepSeek 密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=15
LLM_MAX_RETRY=1
LLM_TEMPERATURE=0.2
# ---------------- 生成 / 重排 / 多路召回（默认全部走硅基流动免费模型） ----------------
# 对话模型（免费档：Qwen/Qwen2.5-7B-Instruct 实测 ~0.35s；也可换 THUDM/GLM-4-9B-0414）
RAG_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
RAG_LLM_HELPER_MODEL=Qwen/Qwen2.5-7B-Instruct
# 想换回 DeepSeek：设置 LLM_BASE_URL / LLM_API_KEY / RAG_LLM_MODEL 即可
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxx
# RAG_LLM_MODEL=deepseek-chat

# 重排序（免费档可用；关掉可省 ~0.4s，但 open 模式 Recall 掉约 4 个百分点）
# 重排默认关闭：带过滤的产品路径上零增益（不含重排的基线 Top3 命中率已是 1.000），却多花 ~300ms；
# 只有"无过滤(open)"场景有价值，那时建议同时把候选数调到 20
RAG_RERANK_ENABLED=0
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CANDIDATES=6

# 第 3 路关键词/标题召回（权重 1.0 = 与其他两路等权参与 RRF）
RAG_KEYWORD_ENABLED=1
RAG_TOP_K_KEYWORD=10
RAG_KEYWORD_WEIGHT=1.0
RAG_KEYWORD_MIN_COVERAGE=0.0

# 多轮对话与接地校验
RAG_DIALOGUE_MAX_TURNS=6
RAG_DIALOGUE_REWRITE=1
RAG_FAITHFULNESS_CHECK=1
