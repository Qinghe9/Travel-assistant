# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不要提交）
# 硅基流动：https://cloud.siliconflow.cn/me/account/ak

RAG_EMBED_PROVIDER=api
RAG_EMBED_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBED_API_KEY=sk-在这里填你的密钥
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_EMBED_DIM=1024
RAG_EMBED_BATCH=32

# 本地兜底（可选）
# RAG_EMBED_FALLBACK=BAAI/bge-small-zh-v1.5

# 向量库：local=本地持久化；http=独立 Chroma 容器
RAG_CHROMA_MODE=local
# RAG_CHROMA_HOST=localhost
# RAG_CHROMA_PORT=8002
RAG_COLLECTION=travel_kb_v1
# 对话模型（DeepSeek）
DEEPSEEK_API_KEY=sk-在这里填你的 DeepSeek 密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=15
LLM_MAX_RETRY=1
LLM_TEMPERATURE=0.2
# 对话和辅助改写均走 DeepSeek；不要在这里填写硅基流动 Key。
RAG_LLM_MODEL=deepseek-chat
RAG_LLM_HELPER_MODEL=deepseek-chat

# 重排序（免费档可用；关掉可省 ~0.4s，但 open 模式 Recall 掉约 4 个百分点）
# 重排默认关闭：带过滤的产品路径上零增益（不含重排的基线 Top3 命中率已是 1.000），却多花 ~300ms；
# 只有"无过滤(open)"场景有价值，那时建议同时把候选数调到 20
RAG_RERANK_ENABLED=0
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CANDIDATES=6

# 第 3 路关键词/标题召回（权重 1.0 = 与其他两路等权参与 RRF）
RAG_KEYWORD_ENABLED=1
RAG_TOP_K_KEYWORD=10
RAG_KEYWORD_WEIGHT=1.0
RAG_KEYWORD_MIN_COVERAGE=0.0
RAG_EXACT_PHRASE_BOOST=0.04

# 多轮对话与接地校验
RAG_DIALOGUE_MAX_TURNS=6
RAG_DIALOGUE_REWRITE=1
RAG_FAITHFULNESS_CHECK=1
RAG_ANSWER_TIMEOUT=30
RAG_TTFT_GATE_S=2.0
LLM_MAX_TOKENS=256
RAG_EVIDENCE_MAX_CHARS=900
RAG_EVIDENCE_TOTAL_CHARS=1600

# ============ Agent 层（可选，全部有默认值） ============
# 记忆：sqlite=跨进程保留（验收要求）；memory=仅进程内
AGENT_MEMORY=sqlite
# AGENT_DB_PATH=data/agent/agent.db
# AGENT_PROFILE_DB=data/agent/profile.db
# AGENT_TRACE_LOG=data/agent/traces.jsonl
# AGENT_TRACE_ENABLED=1
# AGENT_CLASSIFY_MAX_TOKENS=256
# 日期槽位超过多少小时未再次表达就清空（默认 24）
# AGENT_DATE_TTL_HOURS=24
# 无密钥时允许规则式降级（不是 mock；降级路径同样不编造事实）
# AGENT_ALLOW_RULE_FALLBACK=1

# 工具密钥（不配则该工具如实返回"暂不可用"，绝不返回估计值）
# OPENTRIPMAP_API_KEY=
# ORS_API_KEY=
# TRAVELPORT_CREDENTIALS=

# 高德地图 Web 服务 Key（景点 POI、路线距离；可选天气）
# 控制台：https://console.amap.com/dev/key/app  （Key 类型选「Web服务」）
# AMAP_API_KEY=
# 天气数据源：open-meteo（默认，无需 Key）| amap（需上面的 Key）
# WEATHER_PROVIDER=open-meteo

# JevK5 结构化决策（意图路由；不生成回答）
# 控制台：https://www.showapi.com/console#/myApp
# JEV_APP_KEY=
# JEV_MODEL=JevK5-V0.3
# JEV_MODE=gateway        # gateway: route.showapi.com | native: jev.showapi.com
# JEV_TIMEOUT=5
# JEV_MIN_CONFIDENCE=0.55
